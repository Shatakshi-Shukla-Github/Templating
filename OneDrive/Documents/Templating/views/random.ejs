<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Random Numbers</title>
</head>

<body>
    <h1>Your Random Number is:- <%=num%>
    </h1>
    <%if(num%2===0){%>
        <h2>That is an Even Number</h2>
        <%}else {%>
            <h2>That is an Odd Number</h2>
            <%}%>
</body>

</html>